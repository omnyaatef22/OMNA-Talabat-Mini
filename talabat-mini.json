r empty\",\"answer\":\"short reply if intent is question or other, in the customer language\"}. ' +\n  'Never invent item_ids. Customer message: <<<' + m.text + '>>>' } }];"},"id":"n201","name":"Prepare Order Parsing","type":"n8n-nodes-base.code","typeVersion":2,"position":[1824,272]},{"parameters":{"method":"POST","url":"https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent","authentication":"predefinedCredentialType","nodeCredentialType":"googlePalmApi","sendBody":true,"specifyBody":"json","jsonBody":"={{ JSON.stringify({ contents: [{ parts: [{ text: $json.prompt }].concat($json.b64 ? [{ inline_data: { mime_type: $json.mime, data: $json.b64 } }] : []) }], generationConfig: { responseMimeType: 'application/json', temperature: 0.1 } }) }}","options":{"timeout":60000}},"id":"n202","name":"AI Parse Order","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[2032,272],"retryOnFail":true,"maxTries":3,"waitBetweenTries":2000,"onError":"continueErrorOutput"},{"parameters":{"jsCode":"// The AI only maps words to item_ids. Prices, stock, limits, zones and hours are checked here.\nconst m = $('Decide Step').first().json;\nconst menu = Object.fromEntries($('Read Menu').all().map(i => [i.json.item_id, i.json]));\nconst zones = Object.fromEntries($('Read Zones').all().map(i => [i.json.zone.toLowerCase(), i.json]));\nlet a; try { a = JSON.parse(($json.candidates?.[0]?.content?.parts || []).map(p => p.text).join('')); } catch (e) { a = null; }\nconst ar = /[\\u0600-\\u06FF]/.test(m.text);\nconst T = (en, arb) => ar ? arb : en;\nif (!a) return [{ json: { ...m, ok: false, reply: T('Sorry, I could not read that. Please write your order like: 2 koshary large, 1 rice pudding, address in Dokki.', 'معلش مقدرتش أفهم الطلب. اكتب مثلاً: ٢ كشري كبير و ١ رز بلبن، والعنوان في الدقي.') } }];\nif (a.intent !== 'order') return [{ json: { ...m, ok: false, reply: a.answer || T('Send your order and address and I will prepare it for you.', 'ابعت طلبك والعنوان وأنا أجهزهولك.') } }];\nconst p = []; const lines = [];\nconst hour = $now.setZone('Africa/Cairo').hour; if (hour < 11) p.push(T('we open at 11:00', 'بنفتح الساعة ١١ الصبح'));\nfor (const it of a.items || []) {\n  const x = menu[it.item_id]; const q = Math.round(Number(it.qty));\n  if (!x) { p.push(T('unknown item', 'صنف مش في المنيو')); continue; }\n  if (x.in_stock !== 'yes') { p.push(T(x.name_en + ' is sold out', x.name_ar + ' خلصان النهارده')); continue; }\n  if (!(q >= 1 && q <= 20)) { p.push(T('quantity for ' + x.name_en + ' must be 1–20', 'الكمية لازم من ١ لـ ٢٠')); continue; }\n  lines.push({ item_id: x.item_id, name: ar ? x.name_ar : x.name_en, qty: q, price: Number(x.price_egp), total: q * Number(x.price_egp) });\n}\nif ((a.unmatched || []).length) p.push(T('not on the menu: ', 'مش موجود في المنيو: ') + a.unmatched.join(', '));\nif (!lines.length) p.push(T('no items found', 'مفيش أصناف في الطلب'));\nconst z = zones[String(a.zone || '').toLowerCase()];\nif (!z) p.push(T('we deliver to: ', 'بنوصل لـ: ') + Object.values(zones).map(z => z.zone).join(', '));\nif (!a.address || a.address.length < 8) p.push(T('please send the full address', 'محتاجين العنوان بالتفصيل'));\nconst subtotal = lines.reduce((s, l) => s + l.total, 0);\nif (z && subtotal < Number(z.min_order_egp)) p.push(T('minimum order for ' + z.zone + ' is ' + z.min_order_egp + ' EGP', 'الحد الأدنى للطلب في ' + z.zone + ' هو ' + z.min_order_egp + ' جنيه'));\nif (p.length) return [{ json: { ...m, ok: false, reply: T('Almost there: ', 'فاضل حاجة بسيطة: ') + p.join(' · ') } }];\nconst fee = Number(z.delivery_fee_egp), total = subtotal + fee;\nconst id = 'O-' + $now.setZone('Africa/Cairo').toFormat('yyMMdd-HHmm') + '-' + Math.random().toString(36).slice(2, 5).toUpperCase();\nconst summary = lines.map(l => l.qty + ' × ' + l.name + ' = ' + l.total).join('\\n');\nreturn [{ json: { ...m, ok: true, order_id: id, items_json: JSON.stringify(lines), subtotal, delivery_fee: fee, total, zone: z.zone, address: a.address,\n  reply: T('Your order ' + id + ':\\n' + summary + '\\nDelivery ' + fee + ' · Total ' + total + ' EGP\\nTo: ' + a.address + '\\n\\nReply YES to confirm or CANCEL.', 'طلبك ' + id + ':\\n' + summary + '\\nالتوصيل ' + fee + ' · الإجمالي ' + total + ' جنيه\\nالعنوان: ' + a.address + '\\n\\nابعت \"أيوه\" للتأكيد أو \"إلغاء\".') } }];"},"id":"n203","name":"Validate Order","type":"n8n-nodes-base.code","typeVersion":2,"position":[2224,272]},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"loose","version":3},"conditions":[{"id":"c204","leftValue":"={{ $json.ok }}","rightValue":"","operator":{"type":"boolean","operation":"true","singleValue":true}}],"combinator":"and"},"looseTypeValidation":true,"options":{}},"id":"n205","name":"Order Valid?","type":"n8n-nodes-base.if","typeVersion":2.3,"position":[2432,272]},{"parameters":{"operation":"append","documentId":{"__rl":true,"value":"YOUR_ID","mode":"id"},"sheetName":{"__rl":true,"value":403,"mode":"id","cachedResultName":"Orders"},"columns":{"mappingMode":"defineBelow","value":{"order_id":"={{ $json.order_id }}","created_at":"={{ $now.setZone('Africa/Cairo').toFormat('yyyy-MM-dd HH:mm') }}","channel":"={{ $json.channel }}","customer_id":"={{ $json.customer_id }}","wa_phone_id":"={{ $json.wa_phone_id }}","customer_name":"={{ $json.customer_name }}","items_json":"={{ $json.items_json }}","subtotal":"={{ $json.subtotal }}","delivery_fee":"={{ $json.delivery_fee }}","total":"={{ $json.total }}","zone":"={{ $json.zone }}","address":"={{ $json.address }}","status":"awaiting_confirmation","updated_at":"={{ $now.setZone('Africa/Cairo').toFormat('yyyy-MM-dd HH:mm') }}"},"matchingColumns":[],"schema":[{"id":"order_id","displayName":"order_id","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":true,"removed":false},{"id":"created_at","displayName":"created_at","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch