    {
      "parameters": {
        "jsCode": "// Kitchen must accept within 5 minutes; unconfirmed drafts expire after 30 minutes.\nconst now = $now.setZone('Africa/Cairo'); const P = s => DateTime.fromFormat(String(s || ''), 'yyyy-MM-dd HH:mm', { zone: 'Africa/Cairo' });\nconst out = [];\nfor (const { json: o } of $input.all()) {\n  if (!o.order_id) continue; const age = now.diff(P(o.updated_at || o.created_at), 'minutes').minutes;\n  if (o.status === 'sent_to_kitchen' && age >= 5) out.push({ json: { action: 'escalate', order: o, text: '🚨 Order ' + o.order_id + ' waiting ' + Math.round(age) + ' min for the kitchen to accept (' + o.total + ' EGP, ' + o.zone + ')' } });\n  if (o.status === 'awaiting_confirmation' && age >= 30) out.push({ json: { action: 'expire', order: o } });\n}\nreturn out;"
      },
